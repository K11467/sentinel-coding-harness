{
  "name": "sentinel-coding-harness",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "DEMO_GUIDE.md",
    "REFERENCES.md",
    "SPEC.md",
    "THREAT_MODEL.md"
  ],
  "bin": {
    "sentinel": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "demo": "npm run build && node dist/cli.js demo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepack": "npm_config_offline=true npm run build",
    "release:preflight": "npm_config_offline=true npm run check && node scripts/release-preflight.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  }
}
